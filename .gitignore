# Local working materials (not part of the published site)
context/
context/**

# Assembled site (built locally / by CI)
_site/

# App build artifacts (also ignored via apps/*/.gitignore)
apps/*/node_modules/
apps/*/.next/
apps/*/out/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Logs and temp
*.log
.server.log
.server.pid
tmp/
temp/
.cache/
